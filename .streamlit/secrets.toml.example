[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "REPLACE_WITH_IDENTITY_PROVIDER_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
expose_tokens = ["id"]

[roles]
admin_groups = ["homenest-admin"]
manager_groups = ["homenest-manager"]
admin_emails = []
manager_emails = []
# Optional URL to the identity provider's account/group administration console.
# admin_console_url = "https://console.example.com/"
