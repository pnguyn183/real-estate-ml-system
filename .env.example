# Real Estate Price Prediction - Environment Configuration
# Compose reads only variables explicitly interpolated in docker-compose.yml.
# Topic/group/database values below document standalone-process settings;
# Compose and kafka-init use fixed topology names, not these .env overrides.

# =============================================================================
# KAFKA Configuration
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=kafka:29092,kafka2:29093,kafka3:29094
KAFKA_RAW_TOPIC=real_estate_raw
KAFKA_CLEAN_TOPIC=real_estate_features
KAFKA_GROUP_ID=real_estate_training_pipeline

# =============================================================================
# MongoDB Configuration
# =============================================================================
MONGO_URI=mongodb://mongodb:27017/
MONGO_DB=real_estate_db
MONGO_FEATURE_COLLECTION=training_features

# =============================================================================
# Price anomaly detection (historical group-based IQR)
# =============================================================================
PRICE_ANOMALY_IQR_MULTIPLIER=1.5
PRICE_ANOMALY_MIN_GROUP_SIZE=30
PRICE_ANOMALY_GROUP_COLUMNS=province_slug,district_slug,property_type
PRICE_ANOMALY_FALLBACK_GROUP_COLUMNS=province_slug,property_type
PRICE_ANOMALY_REFRESH_SECONDS=300
# KEEP/FLAG retain anomalies for training; EXCLUDE removes only flagged records.
PRICE_ANOMALY_TRAINING_POLICY=FLAG

# =============================================================================
# Offline text enrichment / optional LLM review
# =============================================================================
# The built-in embedding is deterministic local hashing (32 dimensions). This
# SQLite cache prevents recomputing unchanged listing text during ingestion.
TEXT_EMBEDDING_CACHE_PATH=runtime/text_embedding_cache.sqlite
# This older anomaly-review extension remains disabled (it has no provider).
# The separate Kafka extraction agent below does not replace anomaly review.
LLM_REVIEW_ENABLED=false

# Optional Gemini extraction is configured once in the agent section below.

# =============================================================================
# Model Configuration
# =============================================================================
MODEL_PATH=artifacts/models/price_model.joblib
METRICS_PATH=artifacts/price_model_metrics.json
MIN_RECORDS_FOR_TRAINING=30
TRAIN_INTERVAL=1800
TRAIN_RETRY_INTERVAL=60

# =============================================================================
# Scraper Configuration
# =============================================================================
# Only these three adapters exist. Guland live crawling is disabled in its
# adapter pending collection permission and live mapping review.
ENABLED_SOURCES=alonhadat,homedy
CRAWL_ENABLED=false
ALONHADAT_CATEGORY_URL=https://alonhadat.com.vn/can-ban-nha-dat
GULAND_CATEGORY_URL=https://guland.vn/mua-ban-bat-dong-san-tp-ho-chi-minh
HOMEDY_CATEGORY_URL=https://homedy.com/ban-nha-dat
CRAWL_METRICS_PORT=8008
SCRAPE_LIMIT=10
SCRAPE_MAX_PAGES=1
SCRAPE_INITIAL_LIMIT=10
SCRAPE_INITIAL_MAX_PAGES=1
SCRAPE_START_PAGE=1
SCRAPE_INTERVAL=1800
SCRAPE_TIMEOUT=300
SCRAPE_REQUEST_DELAY=2
SCRAPE_DETAIL_DELAY=2
SCRAPE_DELAY_MIN=2
SCRAPE_DELAY_MAX=5
CRAWLER_USER_AGENT=RealEstatePipelineCrawler/1.0
SCRAPE_HTTP_TIMEOUT=30
SCRAPE_HTTP_ATTEMPTS=4
SCRAPE_MAX_RESPONSE_BYTES=32000000
SCRAPE_KAFKA_DELIVERY_TIMEOUT=30
# HTTP 403/robots denial stops the attempt; delay/headers do not bypass blocking.
# Optional Airflow profile starts paused. With CONTROL_ENABLED=false, stop
# scraper AND trainer before unpausing its DAG. With control enabled, stop only
# scraper: the dedicated trainer owns fitting. See airflow/README.md.
SCRAPE_INCLUDE_UNVERIFIED=false
SCRAPE_FRESH_START=false
SCRAPE_INITIAL_FRESH_START=false
SCRAPE_STATE_FILE=runtime/scrape_state/producer_state.json
SCRAPE_INITIAL_STATE_FILE=runtime/scrape_state/producer_state.json
# Revisit acknowledged listings after one day; prioritize unseen URLs.
SCRAPE_REVISIT_SECONDS=86400
# Stop a failing source after three consecutive detail errors; others continue.
SCRAPE_MAX_CONSECUTIVE_FAILURES=3

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*,localhost:3000
# Set a unique secret in .env/production; do not commit it.
AUTH_SECRET_KEY=change-this-in-your-local-env-not-a-production-secret

# =============================================================================
# Prediction Service Configuration
# =============================================================================
PREDICTOR_HOST=0.0.0.0
PREDICTOR_PORT=8002

# =============================================================================
# Metrics Configuration
# =============================================================================
PROMETHEUS_METRICS_PORT=8003
PROMETHEUS_INTERVAL=15

# =============================================================================
# Frontend Configuration
# =============================================================================
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=RealEstateAI
VITE_APP_VERSION=1.0.0

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# =============================================================================
# Agent queues and synthetic isolation (same 3 brokers, same 3 Processors)
# =============================================================================
KAFKA_STRESS_TOPIC=real_estate_stress_raw
MONGO_STRESS_DB=real_estate_stress_db
KAFKA_AI_TOPIC=real_estate_ai_input
KAFKA_AI_RESULT_TOPIC=real_estate_ai_results
KAFKA_AI_DLQ_TOPIC=real_estate_ai_dlq
KAFKA_AI_GROUP_ID=real_estate_ai_extraction

# Safe defaults: no generation and no paid external requests at startup.
STRESS_ENABLED=false
STRESS_SCENARIO=mixed
STRESS_MULTIPLIER=10
STRESS_RATE_PER_SECOND=1
STRESS_DURATION_SECONDS=60
STRESS_MAX_RECORDS=1000
STRESS_BURST_RATE=10
STRESS_BURST_DURATION=5
STRESS_DUPLICATE_RATIO=0.10
STRESS_UNSTRUCTURED_RATIO=0.30
STRESS_SEED=42
# Give every deliberate run a distinct ID. Completed IDs are not rerun.
STRESS_RUN_ID=default
STRESS_TEMPLATE_SOURCE=builtin
STRESS_TEMPLATE_LIMIT=100
STRESS_MAX_RATE=100
STRESS_LOAD_PROFILE=normal

# Enable worker AND the desired processor routing gate deliberately.
AI_ENABLED=false
AI_FALLBACK_ENABLED=false
# Separate opt-in: permitting real AI does not permit stress API charges.
AI_STRESS_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Verified with this project's provider account on 2026-09-24; recheck availability.
LLM_MODEL=gemini-3.6-flash
# Placeholder only. Put the actual key in ignored .env, never in this file.
LLM_API_KEY=
# Compose uses this when LLM_API_KEY is empty.
GEMINI_API_KEY=
# Optional comma-separated event IDs for local audit; empty means no provider I/O audit.
AI_AUDIT_EVENT_IDS=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
AI_MAX_CONCURRENT_REQUESTS=1
AI_RATE_LIMIT_PER_MINUTE=20
AI_MIN_CONFIDENCE=0.75
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_SECONDS=60
AI_TOTAL_BUDGET_SECONDS=120
AI_KAFKA_DELIVERY_TIMEOUT_SECONDS=30

# Optional configured fallback, shared by extraction and the control agent.
# Free plans still have quotas. Set provider/model/key together to enable it.
LLM_FALLBACK_PROVIDER=disabled
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_COOLDOWN_SECONDS=30
LLM_QUOTA_COOLDOWN_SECONDS=3600

# LLM feedback control runs on the Docker HOST: python -m agents.control_agent
# These are hard operating bounds, not rules mapping CPU % to a state/rate.
CONTROL_ENABLED=false
CONTROL_RESOURCE_ENABLED=false
CONTROL_SOURCE_TOPIC=real_estate_stress_raw
CONTROL_POLICY_PATH=runtime/control/policy.json
CONTROL_FAILSAFE_RATE=0
CONTROL_MAX_RATE=100
CONTROL_SAMPLE_SECONDS=5
CONTROL_DECISION_SECONDS=30
CONTROL_TIMEOUT_SECONDS=20
CONTROL_LEASE_SECONDS=90
CONTROL_MAX_SAMPLE_AGE_SECONDS=30
CONTROL_HISTORY_SIZE=12
CONTROL_MIN_MEMORY_AVAILABLE_PERCENT=10
CONTROL_TARGET_LATENCY_SECONDS=2
CONTROL_CPU_BUDGET_FRACTION=0.75
CONTROL_MEMORY_BUDGET_FRACTION=0.70
CONTROL_KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094

# Empty groups inherit LLM / LLM_FALLBACK. A separate endpoint needs its own key.
CONTROL_LLM_PROVIDER=
CONTROL_LLM_BASE_URL=
CONTROL_LLM_MODEL=
CONTROL_LLM_API_KEY=
CONTROL_LLM_FALLBACK_PROVIDER=
CONTROL_LLM_FALLBACK_BASE_URL=
CONTROL_LLM_FALLBACK_MODEL=
CONTROL_LLM_FALLBACK_API_KEY=

# Explicit initial allocations allow verified live changes and exact rollback.
# Swap limits below are RAM + swap, not additional swap alone.
PROCESSOR_CPU_LIMIT=1.0
PROCESSOR_MEMORY_LIMIT=768M
PROCESSOR_SWAP_LIMIT=1536M
TRAINER_CPU_LIMIT=1.0
TRAINER_MEMORY_LIMIT=1024M
TRAINER_SWAP_LIMIT=2048M
