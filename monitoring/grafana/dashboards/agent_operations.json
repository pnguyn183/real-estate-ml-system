    {
      "id": 6,
      "type": "timeseries",
      "title": "AI work: routing, extraction and durable hand-off",
      "description": "Different stages, not a one-to-one funnel: response-cache hits skip extraction; completed worker outcomes include stale/failed records. Worker completion means durable handling/result delivery, NOT downstream MongoDB feature persistence.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(processor_ai_requests_total{job=~\"processor(-[23])?\",outcome=\"queued\"}[$__rate_interval]))",
          "legendFormat": "Processor queued AI request",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(ai_extraction_requests_total{job=\"ai-agent\"}[$__rate_interval]))",
          "legendFormat": "Extraction requests (cache misses)",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "range": true
        },
        {
          "refId": "C",
          "expr": "sum(rate(ai_extraction_success_total{job=\"ai-agent\"}[$__rate_interval]))",
          "legendFormat": "Schema + confidence + evidence accepted",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "range": true
        },
        {
          "refId": "D",
          "expr": "sum(rate(ai_records_completed_total{job=\"ai-agent\"}[$__rate_interval]))",
          "legendFormat": "Worker completed hand-offs",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "AI failures and recoverable outcomes",
      "description": "Reasons come from actual bounded failure labels. Low confidence is a rejection, not an API outage. Fallback means returning failure/review output, not automatic recovery or a human review service.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(ai_extraction_failure_total{job=\"ai-agent\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (outcome) (rate(ai_records_completed_total{job=\"ai-agent\",outcome=~\"failed|malformed|stale\"}[$__rate_interval]))",
          "legendFormat": "worker {{outcome}}",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Extraction time (approximate percentiles)",
      "description": "Existing end-to-end extraction histogram includes local validation and retries, and also disabled/rejected calls. It is NOT isolated network API latency. Highest finite bucket is 30 seconds; longer-tail percentile estimates are limited by that bucket layout.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(ai_extraction_duration_seconds_bucket{job=\"ai-agent\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_extraction_duration_seconds_bucket{job=\"ai-agent\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Provider confidence distribution — not accuracy",
      "description": "Disjoint histogram bands of schema-valid provider self-reports, before confidence/evidence checks. Includes later-rejected outputs; excludes malformed schema and cached replays. Bands are fixed observation buckets, NOT the configurable acceptance threshold. No confidence calibration or labelled extraction-accuracy metric exists.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(ai_extraction_confidence_bucket{job=\"ai-agent\",le=\"0.25\"}[$__rate_interval]))",
          "legendFormat": "[0, 0.25]",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(ai_extraction_confidence_bucket{job=\"ai-agent\",le=\"0.5\"}[$__rate_interval])) - sum(rate(ai_extraction_confidence_bucket{job=\"ai-agent\",le=\"0.25\"}[$__rate_interval]))",
          "legendFormat": "(0.25, 0.5]",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "range": true
        },
        {
          "refId": "C",
          "expr": "sum(rate(ai_extraction_confidence_bucket{job=\"ai-agent\",le=\"0.75\"}[$__rate_interval])) - sum(rate(ai_extraction_confidence_bucket{job=\"ai-agent\",le=\"0.5\"}[$__rate_interval]))",
          "legendFormat": "(0.5, 0.75]",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "range": true
        },
        {
          "refId": "D",
          "expr": "sum(rate(ai_extraction_confidence_bucket{job=\"ai-agent\",le=\"0.9\"}[$__rate_interval])) - sum(rate(ai_extraction_confidence_bucket{job=\"ai-agent\",le=\"0.75\"}[$__rate_interval]))",
          "legendFormat": "(0.75, 0.9]",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "range": true
        },
        {
          "refId": "E",
          "expr": "sum(rate(ai_extraction_confidence_bucket{job=\"ai-agent\",le=\"1.0\"}[$__rate_interval])) - sum(rate(ai_extraction_confidence_bucket{job=\"ai-agent\",le=\"0.9\"}[$__rate_interval]))",
          "legendFormat": "(0.9, 1]",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "range": true
        }
      ]
    },
