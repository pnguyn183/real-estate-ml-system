    {
      "id": 14,
      "type": "timeseries",
      "title": "Provider calls, retries and throttling",
      "description": "Provider-call counter means an attempted provider-interface call, not proof that a real external request succeeded. Limits are per AI process, not a cluster-wide spending cap; retries consume call budget.",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
